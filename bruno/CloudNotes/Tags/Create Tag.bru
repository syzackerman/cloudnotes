meta {
  name: Create Tag
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tags
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Work"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("tagId", res.body.id);
  }
}
