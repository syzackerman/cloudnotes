meta {
  name: Create Note
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/notes
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "CloudNotes demo note",
    "content": "Created from the Bruno collection."
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("noteId", res.body.id);
  }
}
