# Copy this file outside Git tracking on the EC2 host and replace every placeholder.
# Prefer scripts/start-production.sh with AWS Systems Manager Parameter Store so
# DATABASE_PASSWORD and JWT_SECRET are not persisted in a local file.

SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=PT1H
AWS_REGION=
AWS_S3_BUCKET=
ECR_IMAGE_URI=
SERVER_PORT=8080
APP_DOMAIN=api.example.com

SWAGGER_ENABLED=false
CORS_ALLOWED_ORIGINS=
MANAGEMENT_PROMETHEUS_ENABLED=false
MANAGEMENT_ENDPOINTS=health

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_CAPACITY=10
RATE_LIMIT_LOGIN_WINDOW=PT1M
RATE_LIMIT_REGISTRATION_CAPACITY=5
RATE_LIMIT_REGISTRATION_WINDOW=PT1H
RATE_LIMIT_UPLOAD_CAPACITY=30
RATE_LIMIT_UPLOAD_WINDOW=PT1H
RATE_LIMIT_DOWNLOAD_URL_CAPACITY=60
RATE_LIMIT_DOWNLOAD_URL_WINDOW=PT1M
PAGE_MAX_SIZE=100

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
DOWNLOAD_URL_EXPIRATION=PT5M
