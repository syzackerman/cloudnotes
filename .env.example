# Local Maven run: jdbc:postgresql://localhost:5432/cloudnotes
# Docker Compose app container: jdbc:postgresql://postgres:5432/cloudnotes
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

SERVER_PORT=8080

# Use at least 32 bytes. Do not reuse this placeholder in production.
JWT_SECRET=
JWT_EXPIRATION=PT1H

# Local S3 testing can use environment credentials.
# Production on EC2 should use an IAM role instead of stored access keys.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API docs are enabled by default locally. Set false to hide Swagger/OpenAPI.
SWAGGER_ENABLED=true

# Comma-separated frontend origins. Empty means CORS is denied by default.
CORS_ALLOWED_ORIGINS=

# Metrics are disabled by default except health. Enable only for protected/private access.
MANAGEMENT_PROMETHEUS_ENABLED=false
MANAGEMENT_ENDPOINTS=health

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_CAPACITY=10
RATE_LIMIT_LOGIN_WINDOW=PT1M
RATE_LIMIT_REGISTRATION_CAPACITY=5
RATE_LIMIT_REGISTRATION_WINDOW=PT1H
RATE_LIMIT_UPLOAD_CAPACITY=30
RATE_LIMIT_UPLOAD_WINDOW=PT1H
RATE_LIMIT_DOWNLOAD_URL_CAPACITY=60
RATE_LIMIT_DOWNLOAD_URL_WINDOW=PT1M
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100
PAGE_ALLOWED_SORT_FIELDS=createdAt,updatedAt,title

MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
DOWNLOAD_URL_EXPIRATION=PT5M
